# Copy to .env.local and fill in from the Supabase project's API settings.
# .env.local is gitignored; THIS file is committed, so it must never hold a
# real value.

NEXT_PUBLIC_SUPABASE_URL=

# The public origin magic-link emails should return to, e.g.
# https://digijar.app. Leave blank for local web development and it falls back
# to window.location.origin. REQUIRED for the Capacitor build, where that origin
# is capacitor://localhost and no mail client can open it. Whatever you set here
# must also be in the Supabase project's redirect allow-list.
NEXT_PUBLIC_SITE_URL=

# Supabase is moving from the legacy `anon` JWT to a publishable key. Either
# works with supabase-js — set whichever your project shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anything NEXT_PUBLIC_ is compiled into the browser bundle and is readable by
# anyone. That is fine for the URL and the publishable/anon key — row level
# security is what protects the data. It is NOT fine for the database password
# or a service_role key. Those are not used by the app at all; keep them out of
# this file and out of Vercel's client-side environment.
